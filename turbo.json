{
  "$schema": "https://turbo.build/schema.json",
  /* "stream", not "tui": the interactive terminal UI hangs on the
     cache-write step in Windows PowerShell, and produces unreadable
     output in CI logs. Streamed output is plain, portable, and greppable. */
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.spec.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      /* Build dependencies before starting. The API compiles against
         packages/shared's emitted .d.ts, so a dev server started without
         this runs against whatever dist/ happens to be on disk — which is
         how a stale build survives four separate debugging sessions. */
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      /* Turbo 2 runs tasks in strict env mode: a variable the task does not
         declare is absent from its environment, silently. That is the right
         default — it is what makes a cache hit trustworthy — but it means an
         undeclared REDIS_TEST_URL never reaches Jest, so the Redis-backed
         suites skip themselves while CI reports green. Declaring it also
         puts it in the cache key, so "ran with a real Redis" and "ran
         without one" stop being the same cache entry. */
      "env": ["REDIS_TEST_URL"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_TEST_URL"],
      "cache": false,
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
