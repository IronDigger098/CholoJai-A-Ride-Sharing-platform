# Keep node_modules strict: a package may only import what it declares.
# Prevents "phantom dependencies" — code that works locally because a
# transitive dep happened to be hoisted, then breaks when that dep changes.
#
# `@types/*` is the one exception, and only inside the store. A third-party
# .d.ts references its own type-only peers: react-leaflet declares
# `useMap(): Map`, importing Map from leaflet, and Next's `dynamic` returns
# a `React.ComponentType`. Both list those typings as devDependencies, so
# with nothing hoisted they cannot resolve from where the .d.ts lives and
# the types quietly degrade to error types. `skipLibCheck` hides that from
# tsc; typescript-eslint surfaces it as "unsafe assignment of an error typed
# value".
#
# `hoist-pattern` writes into node_modules/.pnpm/node_modules, which is on
# the resolution path of packages inside the store and NOT on ours — so this
# fixes third-party declarations without making a single phantom dependency
# reachable from our own source.
hoist=true
hoist-pattern[]=@types/*
strict-peer-dependencies=false

# Reproducible installs: CI must fail on a stale lockfile, never silently fix it.
prefer-frozen-lockfile=true

# Explicit approval for postinstall scripts (supply-chain hygiene).
enable-pre-post-scripts=false