# CholoJai — environment template.
#
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
# Every variable here is documented in docs/environment-variables.md and
# validated by a Zod schema at API boot — a missing or malformed value
# crashes the process immediately with a readable message.
#
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (PowerShell)

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ─── Public origins ───────────────────────────────────────────────────────
# Used for CORS, Swagger server URLs, and links inside outgoing emails.
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ─── Data stores ──────────────────────────────────────────────────────────
# Port 5433 matches docker-compose.yml, which deliberately avoids the
# default 5432 to prevent collisions with an existing local Postgres.
DATABASE_URL=postgresql://cholojai:cholojai_dev_password@localhost:5433/cholojai_dev?schema=public

# Integration tests truncate every table, so they refuse to run unless this
# is set AND the database name contains "test". Create and migrate it once —
# see the Testing section of README.md for the two commands. Unset, the
# integration suites skip rather than fail.
DATABASE_TEST_URL=postgresql://cholojai:cholojai_dev_password@localhost:5433/cholojai_test?schema=public
REDIS_URL=redis://localhost:6379

# ─── Authentication ───────────────────────────────────────────────────────
# Generate a real secret — do not invent one by hand:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses to start while this still says "change-me".
#
# There is only ONE secret because only the access token is signed. Refresh
# tokens are opaque random strings validated against the database, so they
# carry no signature and need no key — see RefreshTokenService for why.
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
COOKIE_DOMAIN=localhost

# Refresh tokens rotate: each use retires the token and issues a successor.
# REFRESH_TTL_DAYS is the sliding window for one token; REFRESH_ABSOLUTE_TTL_DAYS
# is the hard ceiling on a whole sign-in, so an always-active session still ends.
REFRESH_TTL_DAYS=7
REFRESH_ABSOLUTE_TTL_DAYS=30

# A token replayed within this many seconds of its own rotation is treated as
# a concurrent request (two tabs, a retry on a flaky network) rather than as
# theft. Set to 0 for strict mode, where any replay revokes the whole session.
REFRESH_ROTATION_GRACE_SECONDS=10

# ─── Mail (Mailpit in development — UI at http://localhost:8025) ──────────
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="CholoJai <no-reply@cholojai.local>"

# Left unset locally: Mailpit accepts everything and authenticates nobody.
# Both are REQUIRED in production — a real provider refuses an unauthenticated
# connection, and the failure looks like "the verification email never
# arrived" rather than like a configuration error.
# SMTP_USER=
# SMTP_PASSWORD=

# ─── Geo / routing ────────────────────────────────────────────────────────
# The public OSRM demo server is fine for development and unfit for anything
# else: rate-limited per address, no availability guarantee, and its operators
# ask that it not be used for real traffic. Point this at a self-hosted
# instance before deploying.
OSRM_BASE_URL=https://router.project-osrm.org

# Give up on a route rather than hold a booking request open behind a hung
# provider. Three seconds is generous for a routing query.
OSRM_TIMEOUT_MS=3000

# How long a measured route stays cached. Roads change on the timescale of
# months, so an hour bounds how long a closure takes to leave quotes. It
# cannot affect a completed ride: the fare is snapshotted at booking (D2).
GEO_ROUTE_CACHE_TTL_SECONDS=3600

# Place search and reverse lookup. The public Nominatim instance caps total
# volume and blocks anonymous traffic, so the User-Agent is a requirement
# rather than courtesy. Self-host or use a commercial geocoder in production.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_MS=3000
NOMINATIM_USER_AGENT=CholoJai/0.1

# Addresses do not move, so places are cached far longer than routes. The
# bound exists so a corrected place eventually propagates.
GEO_PLACE_CACHE_TTL_SECONDS=86400

# ─── Fares ────────────────────────────────────────────────────────────────
# How long a quote stays bookable. Short enough that a price cannot be held
# while conditions change, long enough to read three options and choose.
FARE_QUOTE_TTL_SECONDS=300

# The longest journey we will price. estimateFare is pure arithmetic with no
# opinion about geography; this is where that opinion lives.
FARE_MAX_DISTANCE_METRES=100000

# ─── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MIN=100

# Master switch. Turn off only for local load testing; production refuses
# to start with it disabled, because /auth/login runs argon2 per attempt.
RATE_LIMIT_ENABLED=true

# How many reverse proxies sit in front of this process. 0 locally, 1 behind
# Railway. Get it wrong and per-IP limits either throttle every user as one
# client (too low) or can be bypassed with a forged header (too high).
TRUSTED_PROXY_HOPS=0

# ─── API documentation ────────────────────────────────────────────────────
# Unset means: on outside production, off in production. Set explicitly to
# publish docs from a production deployment.
# SWAGGER_ENABLED=true

# ─── Web app (browser-exposed) ────────────────────────────────────────────
# NEXT_PUBLIC_* variables are compiled into the browser bundle and are
# therefore PUBLIC. Never put a secret behind this prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
