# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Generated by next build / next dev from the tsconfig and the route tree.
# Committed, it is a diff nobody wrote on every branch that adds a route,
# and Prettier reformats it into a permanent format:check failure. Prettier
# reads .gitignore, so one entry here covers both problems.
next-env.d.ts

# Turborepo
.turbo/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Test & coverage
coverage/
playwright-report/
test-results/
.nyc_output/

# Prisma
prisma/*.db
prisma/*.db-journal

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Redis snapshot, if a local server is started from the repo root
dump.rdb

# Scratch file for multi-line commit messages written from PowerShell.
commit-msg.txt
