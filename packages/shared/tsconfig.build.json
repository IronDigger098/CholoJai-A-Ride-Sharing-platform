{
  /* The *build* project: production sources only.
     Tests are excluded so they never reach dist/ or the published types. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    /* Keep the incremental cache inside outDir so deleting dist/ always
       invalidates it — see apps/api/tsconfig.build.json for the failure
       mode this prevents. */
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/**"]
}
