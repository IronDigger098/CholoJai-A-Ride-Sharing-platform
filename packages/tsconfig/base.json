{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "CholoJai Base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Strictness — the whole point of this file.
       `strict` is the umbrella; the four below are NOT included in it
       and each closes a real class of runtime bug. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,

    /* Correctness */
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,

    /* Unused code is a review comment, not a build failure —
       ESLint reports these as warnings so refactors aren't blocked. */
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    /* Interop & emit */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
