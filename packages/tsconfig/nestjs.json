{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "CholoJai NestJS API",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",

    /* NestJS dependency injection reads parameter types at runtime
       via reflect-metadata; these two emit that metadata. */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* Nest's DI container legitimately assigns injected properties
       outside the constructor, which strictPropertyInitialization
       cannot see. Disabled deliberately, framework-wide. */
    "strictPropertyInitialization": false
  }
}
